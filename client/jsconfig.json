{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["vite/client"]
  },
  "include": [
    "src/types/**/*.d.ts",
    "src/hooks/**/*.js",
    "src/lib/**/*.js",
    "src/features/**/*.js",
    "src/store/**/*.js",
    "src/config/**/*.js"
  ]
}
