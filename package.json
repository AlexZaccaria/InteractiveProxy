{
  "name": "interactive-proxy",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive Proxy - Development proxy server with modern UI for HTTP/HTTPS/WebSocket interception, local resource management, and request analysis",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "server": "node server/index.js",
    "client": "node dev-client.js",
    "dev": "concurrently -n server,client -c blue,magenta \"npm run server\" \"npm run client\"",
    "start": "node server/index.js",
    "build": "node build-client.js",
    "lint": "eslint .",
    "lint:server": "eslint server scripts *.js",
    "lint:client": "eslint client/src",
    "typecheck": "tsc -p server/jsconfig.json",
    "test": "npm test --workspace server",
    "install-all": "npm install"
  },
  "keywords": [
    "proxy",
    "http",
    "https",
    "websocket",
    "mitm",
    "interceptor",
    "debugging",
    "development",
    "mock",
    "testing",
    "request-analysis",
    "local-resources"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlexZaccaria/InteractiveProxy.git"
  },
  "bugs": {
    "url": "https://github.com/AlexZaccaria/InteractiveProxy/issues"
  },
  "homepage": "https://github.com/AlexZaccaria/InteractiveProxy#readme",
  "engines": {
    "node": ">=22.15.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/node-forge": "^1.3.14",
    "@types/ws": "^8.18.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "typescript": "^7.0.2"
  }
}
